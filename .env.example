# meilin-stt — cấu hình mẫu. Copy thành `.env` rồi sửa.
# `chmod 600 .env` (file này KHÔNG chứa secret mặc định; secret do lớp auth bên ngoài lo).

# --- Bind -------------------------------------------------------------------
# Mặc định chỉ loopback. Bind ra ngoài phải bật STT_ALLOW_PUBLIC=1 (fail-closed).
STT_HOST=127.0.0.1
STT_PORT=8766
STT_ALLOW_PUBLIC=0

# --- Model ------------------------------------------------------------------
# 68m = chất lượng cao (mặc định) | 30m = nhẹ (int8, máy RAM thấp)
STT_MODEL=68m
# Bỏ trống = ~/.cache/sherpa-onnx/<model>. Đặt khi model nằm ở volume khác.
STT_MODEL_DIR=
STT_NUM_THREADS=4

# --- Thiết bị ---------------------------------------------------------------
# cpu | cuda. `meilin-stt-bench --apply` sẽ ghi data/device_profile.json và
# profile này được ưu tiên hơn 2 biến dưới.
STT_DEVICE_INTERACTIVE=cpu
STT_DEVICE_BATCH=cpu
STT_GPU_MIN_FREE_MB=1500
STT_GPU_MAX_UTIL=40

# --- Nhận dạng ---------------------------------------------------------------
STT_PARTIAL=1
STT_PARTIAL_INTERVAL_MS=500
STT_MAX_UTTERANCE_SEC=60
STT_HOTWORDS_SCORE=1.5
STT_AUTO_CORRECT=1
STT_FFMPEG=ffmpeg

# --- Admin -------------------------------------------------------------------
STT_ADMIN_LOOPBACK_ONLY=1

# --- Service được phía trước đảm nhiệm (KHÔNG phải của repo này) -------------
# Auth/throttle/TLS do ingress hoặc agents của máy đích xử lý — xem docs/security.md
# STT_INGRESS_URL=https://stt.example.internal
# STT_INGRESS_NOTE=Bearer token do lớp ingress kiểm tra
